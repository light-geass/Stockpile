FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=
FLASK_SECRET_KEY=
DASHBOARD_ACCESS_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# App settings
BRAND=Signal Desk
CONFIDENCE_THRESHOLD=7
SHORTLIST_PER_BUCKET=4
HOST=127.0.0.1
PORT=5000

# Deploy on a SINGLE instance/worker (e.g. Render WEB_CONCURRENCY=1, no extra instances).
# The FYERS token, the in-memory symbol catalogue and the one-run-at-a-time lock are per-process;
# extra processes re-login to FYERS and invalidate the token held by another, and no shared state syncs them.
# Also deploy FIRST, then click Connect FYERS on the live URL (a redeploy/move can end the FYERS session).
# WEB_CONCURRENCY=1

# Yahoo Finance blocks datacentre IPs (Render included) on the .info endpoint that carries analyst
# consensus/targets. If the dashboard says "Yahoo returned no data to this server", set a residential
# proxy here (http://user:pass@host:port). Left empty, nothing changes.
# YFINANCE_PROXY=

# Persistent PostgreSQL database (Supabase) for watchlists — the app's only stock list.
# Required: set the server-side DATABASE connection string (Supabase → Project settings → Database → Connection
# string), never the project URL (https://<project>.supabase.co) and never the anon/service_role API keys.
# Both variable names are accepted; DATABASE_URL wins when both are set. Keep it out of source control.
# SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
# WATCHLIST_MAX_ITEMS=100

